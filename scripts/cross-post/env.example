# Copy this file to scripts/cross-post/.env.local (or export these in your shell)
# and fill in your own values. Never commit real secrets.
#
# Run with: node --env-file=scripts/cross-post/.env.local scripts/cross-post/publish-essay.mjs <slug>

# Public URL used for canonical links and as the default cover image source.
CROSSPOST_SITE_URL=https://bodhiprotocol.com

# --- Medium ---
# Settings -> Integration tokens on Medium -> generate one for this script.
MEDIUM_INTEGRATION_TOKEN=
# Optional — the script fetches this from /v1/me if left blank.
MEDIUM_USER_ID=

# --- Substack (via its hidden "post by email" address) ---
# Substack dashboard -> Settings -> "Publishing" (or similar) -> posting email address.
SUBSTACK_POST_EMAIL=
# Any SMTP account you control (Gmail app password, SendGrid, etc.) to send FROM.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
